server.port=8080

# Database Configuration (Replace with your actual database credentials)
spring.datasource.url=jdbc:mysql://${DATABASE_HOST:localhost}:${DATABASE_PORT:3306}/${DATABASE_NAME:arogyatrack}?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
spring.datasource.username=${DATABASE_USERNAME:your_database_username}
spring.datasource.password=${DATABASE_PASSWORD:your_database_password}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# Python ML Service Integration URL
arogyatrack.ml-service.url=${ML_SERVICE_URL:http://localhost:5000}

# Security / JWT Configuration
arogyatrack.jwt.secret=${JWT_SECRET:your_base64_256_bit_secret_key_here}
arogyatrack.jwt.expiration-ms=86400000
